#!/usr/bin/env python3
"""PreToolUse hook: deny an Edit or Write that adds a multi-line comment.

`tests-and-comments` caps a comment at one line. The cap is the half a model
cannot self-assess, so it is counted here instead: a run of two or more
consecutive comment lines, a `/* */` spanning more than one line, or a
multi-line docstring is denied before it reaches disk.

Only the length cap is enforced. Whether a comment names a cause outside the
file is still the model's judgement.
"""
import json
import os
import re
import sys

CODE_EXTS = {
    ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs",
    ".java", ".kt", ".swift", ".c", ".h", ".cc", ".cpp", ".hpp", ".cs",
    ".rb", ".php", ".scala", ".sql",
}
SKIP_PATH = re.compile(
    r"(^|/)(node_modules|dist|build|coverage|vendor|\.next|__generated__|migrations)/|"
    r"\.(min|generated|gen|pb)\.|\.d\.ts$"
)
DIRECTIVE = re.compile(
    r"^\s*(#!|//\s*@|/\*\s*@|#\s*(type|noqa|pylint|mypy|ruff|fmt)\b|#\s*-\*-|"
    r"//+\s*(eslint|ts-|tslint|prettier|biome|istanbul|c8|v8|jscpd|sonar|@ts-)|"
    r"/\*+\s*(eslint|global|prettier|biome|istanbul|jscpd))",
    re.I,
)
HEADER = re.compile(r"copyright|spdx|licensed under|all rights reserved", re.I)
LINE_COMMENT = re.compile(r"^\s*(//|#)")
BLOCK_OPEN = re.compile(r"^\s*/\*")
BLOCK_CONT = re.compile(r"^\s*\*")
DOCSTRING = re.compile(r'^\s*[rbuf]*("""|\'\'\')')


def mask_strings(lines, ext):
    """Blank the inside of multi-line string literals so their contents are not read as comments.

    A triple-quoted region counts as a docstring, and stays visible, only when it opens the
    fragment or follows a `def`/`class` header. Anything else is data.
    """
    out = list(lines)
    if ext in {".py", ".pyi"}:
        i = 0
        while i < len(out):
            m = DOCSTRING.match(out[i])
            if not m:
                i += 1
                continue
            quote = m.group(1)
            stripped = out[i].strip()
            if stripped.count(quote) >= 2 and len(stripped) > len(quote):
                i += 1
                continue
            prev = next((l for l in reversed(out[:i]) if l.strip()), "")
            is_doc = prev == "" or prev.rstrip().endswith(":")
            j = i + 1
            while j < len(out) and quote not in out[j]:
                j += 1
            if not is_doc:
                for k in range(i, min(j + 1, len(out))):
                    out[k] = ""
            i = j + 1
        return out
    depth = 0
    for i, line in enumerate(out):
        ticks = len(re.findall(r"(?<!\\)`", line))
        if depth and ticks == 0:
            out[i] = ""
        elif depth:
            out[i] = ""
            depth = (depth + ticks) % 2
        else:
            depth = ticks % 2
    return out


def runs(text, ext=""):
    """Yield (start_line, [lines]) for every comment block longer than one line."""
    lines = mask_strings(text.split("\n"), ext)
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        if DIRECTIVE.match(line):
            i += 1
            continue
        if DOCSTRING.match(line):
            quote = DOCSTRING.match(line).group(1)
            if line.strip().count(quote) >= 2 and len(line.strip()) > len(quote):
                i += 1
                continue
            start, block = i, [line]
            i += 1
            while i < len(lines) and quote not in lines[i]:
                block.append(lines[i])
                i += 1
            if i < len(lines):
                block.append(lines[i])
                i += 1
            if len(block) > 1:
                out.append((start, block))
            continue
        if BLOCK_OPEN.match(line):
            start, block = i, [line]
            i += 1
            while i < len(lines) and "*/" not in block[-1]:
                block.append(lines[i])
                i += 1
            if len(block) > 1:
                out.append((start, block))
            continue
        if LINE_COMMENT.match(line):
            start, block = i, []
            while i < len(lines) and LINE_COMMENT.match(lines[i]) and not DIRECTIVE.match(lines[i]):
                block.append(lines[i])
                i += 1
            if len(block) > 1:
                out.append((start, block))
            continue
        if BLOCK_CONT.match(line) and not line.strip().startswith("*/"):
            i += 1
            continue
        i += 1
    return out


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0
    tool = payload.get("tool_name", "")
    if tool not in ("Edit", "Write"):
        return 0
    ti = payload.get("tool_input") or {}
    path = ti.get("file_path") or ""
    if os.path.splitext(path)[1] not in CODE_EXTS or SKIP_PATH.search(path):
        return 0

    if tool == "Write":
        added = ti.get("content") or ""
        try:
            with open(path) as fh:
                baseline = fh.read()
        except OSError:
            baseline = ""
    else:
        added = ti.get("new_string") or ""
        baseline = ti.get("old_string") or ""

    def norm(text):
        return "\n".join(l.strip() for l in text.split("\n"))

    base_norm = norm(baseline)
    offenders = []
    ext = os.path.splitext(path)[1]
    for start, block in runs(added, ext):
        body = "\n".join(block)
        if norm(body) in base_norm:
            continue
        if start < 15 and HEADER.search(body):
            continue
        offenders.append((start + 1, block))
    if not offenders:
        return 0

    shown = []
    for line_no, block in offenders[:3]:
        head = "\n".join(block[:4])
        more = "" if len(block) <= 4 else f"\n    ... ({len(block)} lines)"
        shown.append(f"  line {line_no}, {len(block)} lines:\n{head}{more}")
    reason = (
        f"Blocked by comment-length-gate: {len(offenders)} multi-line comment "
        f"block(s) in {os.path.basename(path)}.\n\n"
        + "\n\n".join(shown)
        + "\n\nThe tests-and-comments rule caps a comment at one line. Cut each block "
        "to a single line naming the cause outside this file, or delete it and put "
        "the sentence in the PR description or commit message instead. Re-send the "
        "edit once it fits."
    )
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
