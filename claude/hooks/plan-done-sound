#!/usr/bin/env bash
# PostToolUse(ExitPlanMode) marks an approved plan; the next Stop in that session plays a sound.

JQ=$(command -v jq) || exit 0

payload=$(cat)
event=$(printf '%s' "$payload" | "$JQ" -r '.hook_event_name // empty' 2>/dev/null)
session=$(printf '%s' "$payload" | "$JQ" -r '.session_id // empty' 2>/dev/null)
[ -n "$session" ] || exit 0

marker="${TMPDIR:-/tmp}/claude-plan-approved-$session"

case "$event" in
  PostToolUse)
    touch "$marker"
    ;;
  Stop)
    [ -f "$marker" ] || exit 0
    rm -f "$marker"
    nohup afplay "$HOME/.claude/sounds/done.mp3" >/dev/null 2>&1 &
    ;;
esac

exit 0
